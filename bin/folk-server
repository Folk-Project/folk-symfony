<?php
/**
 * Folk server entry point for Symfony (extension mode, fork-after-warm).
 *
 * Master: boot Symfony once + register handlers, then serveForked() forks N
 * worker processes (CoW-shared warm interpreter) and supervises them.
 */

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path']
    ?? dirname(__DIR__, 4) . '/vendor/autoload.php';

if (!file_exists($autoload)) {
    fwrite(STDERR, "folk-server: vendor/autoload.php not found.\n");
    exit(1);
}

// Normalize the autoload path: the Composer bin-proxy (vendor/bin/folk-server)
// sets _composer_autoload_path with a literal ".." (vendor/bin/../autoload.php),
// which string dirname() does NOT collapse. realpath() expands it so the project
// root resolves correctly under both the bin-proxy and a direct/symlinked path.
$autoload = realpath($autoload);

// Set CWD to project root before autoload / bootstrap / fork.
chdir(dirname($autoload, 2));

// on_init lifecycle hooks (phase 97, folk-releases#93): run the [on_init] steps
// from folk.toml BEFORE the framework is loaded, so commands like
// `cp -n .env.example .env`, a `composer install` refresh, or `artisan migrate`
// take effect before the app reads its environment or a listener is bound. With
// exit_on_error = true (default) a failing step raises + exits non-zero, so a
// broken environment never receives traffic. Skipped for the `grpc:descriptors`
// codegen submode (string literal — the class isn't autoloaded yet here).
if (($argv[1] ?? null) !== 'grpc:descriptors' && function_exists('folk_on_init')) {
    folk_on_init($argv[1] ?? 'folk.toml');
}

require $autoload;

// Load .env if symfony/dotenv is available
if (class_exists(\Symfony\Component\Dotenv\Dotenv::class) && file_exists(getcwd() . '/.env')) {
    (new \Symfony\Component\Dotenv\Dotenv())->bootEnv(getcwd() . '/.env');
}

// gRPC descriptor-export submode (phase 87): `folk-server grpc:descriptors <proto…>`
// compiles proto → FileDescriptorSet on stdout and exits, WITHOUT booting the
// framework or forking workers. No-op for any other argv. CWD is already the
// project root (chdir above), so proto paths resolve relative to it.
\Folk\Sdk\Grpc\Codegen\DescriptorCli::maybeHandle($argv);

$configPath = $argv[1] ?? 'folk.toml';

if (!function_exists('folk_version')) {
    fwrite(STDERR, "Error: folk extension is not loaded.\n");
    exit(1);
}

// Bootstrap Symfony kernel once in the master.
$env = $_ENV['APP_ENV'] ?? $_SERVER['APP_ENV'] ?? 'prod';
$debug = (bool) ($_ENV['APP_DEBUG'] ?? $_SERVER['APP_DEBUG'] ?? false);
$kernel = new App\Kernel($env, $debug);

// Register Folk handlers
\Folk\Symfony\FolkBootstrap::register($kernel);

// Create the worker loop and register handlers.
$loop = new \Folk\Sdk\Worker\WorkerLoop();

if (isset($GLOBALS['folk_worker_boot_hook'])) {
    ($GLOBALS['folk_worker_boot_hook'])($loop);
}

// Fork-after-warm: install the dispatch fn, then fork workers + supervise.
$server = new Folk\Server($configPath);
$server->serveForked($loop->prepareDispatch());
