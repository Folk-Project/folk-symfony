{
    "name": "folk/symfony",
    "description": "Symfony integration for Folk application server",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Folk-Project/folk-symfony",
    "keywords": ["folk", "php", "symfony", "server"],
    "authors": [
        { "name": "Folk Contributors" }
    ],
    "require": {
        "php": ">=8.2",
        "folk/sdk": "^0.2.4",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "Folk\\Symfony\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Folk\\Symfony\\Tests\\": "tests/" }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Folk-Project/folk-sdk"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["bin/folk-server"]
}
